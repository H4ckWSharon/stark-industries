# --- Platform ---
NODE_ENV=development
PLATFORM_SECRET=change_me_to_a_long_random_string_for_production

# --- Classroom Auth ---
CLASSROOM_USERNAME=stark_student
CLASSROOM_PASSWORD=IronMan2025!Lab
